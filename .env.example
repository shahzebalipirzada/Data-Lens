# Used by docker-compose.yml. Copy to ".env" and fill in.
# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated emails that become admins when they register
ADMIN_EMAILS=you@example.com

# Keep false for http://localhost. Set true when serving over HTTPS.
COOKIE_SECURE=false
