NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/datalens
CLIENT_ORIGIN=http://localhost:5173

# Required in production. Any long random strings (see the root .env.example for a generator command).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Emails that become admins when they register (comma-separated)
ADMIN_EMAILS=you@example.com

# Cookies: use SameSite=none + Secure only if the client and API are on different sites
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# Set true behind a reverse proxy (nginx, Render, Railway) so rate limiting sees real client IPs
TRUST_PROXY=false
